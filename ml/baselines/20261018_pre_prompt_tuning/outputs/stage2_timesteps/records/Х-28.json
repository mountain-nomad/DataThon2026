  "full": {
    "start": 0,
    "end": 16.53302083333333,
    "events": [
      {
        "t": 0.0,
        "action": "setup",
        "event": "Кассир в розовой блузке сидит за деревянным столом в кабинете с белыми стенами и стеклянной перегородкой, работая на открытом ноутбуке, на столе также лежат два черных устройства, а в соседнем помещении за стеклом виден человек, сидящий за столом."
      },
      {
        "t": 5.0,
        "action": "other",
        "event": "Кассир прекращает печатать, отводит руки от клавиатуры и начинает поворачивать корпус в сторону стеклянной двери."
      },
      {
        "t": 6.6,
        "action": "other",
        "event": "Кассир полностью поворачивается к двери, отталкивается от стула и встает, оставив ноутбук открытым на столе."
      },
      {
        "t": 8.0,
        "action": "other",
        "event": "Кассир подходит к стеклянной двери, отделяющей кабинет от коридора, и берет ручку, чтобы открыть ее."
      },
      {
        "t": 10.0,
        "action": "other",
        "event": "Кассир открывает дверь и выходит в соседнее помещение, за ней следует человек в темной одежде, который двигается в сторону рабочего места."
      },
      {
        "t": 12.0,
        "action": "other",
        "event": "Кассир закрывает за собой стеклянную дверь, оставаясь в соседнем помещении, и поворачивается спиной к кабинету."
      },
      {
        "t": 14.0,
        "action": "other",
        "event": "Кассир проходит вглубь соседнего помещения, удаляясь от двери, при этом ноутбук и устройства остаются на столе в пустом кабинете."
      }
    ],
