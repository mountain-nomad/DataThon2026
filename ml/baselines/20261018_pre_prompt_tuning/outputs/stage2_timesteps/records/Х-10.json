    "events": [
      {
        "t": 0.0,
        "action": "setup",
        "event": "Кассир в розовом кардигане сидит за деревянным столом в кассовом кабинете, на столе лежат деньги, синий предмет и открытые документы, справа стоит открытый ноутбук, слева — кассовое оборудование, в кадре нет клиентов."
      },
      {
        "t": 0.8,
        "action": "other",
        "event": "Кассир откладывает в сторону небольшой тёмный предмет, который держала в руках, и наклоняется к столешнице."
      },
      {
        "t": 1.0,
        "action": "other",
        "event": "Кассир наклоняется и заглядывает в пространство под столешницу, её руки находятся вне зоны видимости."
      },
      {
        "t": 3.8,
        "action": "other",
        "event": "Кассир выпрямляется, её руки снова на столе, она смотрит на лежащие перед ней предметы."
      },
      {
        "t": 4.8,
        "action": "inspect",
        "event": "Кассир берёт со стола синий предмет, рассматривает его в руках и кладёт обратно на столешницу."
      },
      {
        "t": 6.8,
        "action": "other",
        "event": "Кассир берёт со стола деньги, перекладывает их на левую сторону стола и укладывает в приёмный лоток счётчика банкнот."
      },
      {
        "t": 8.0,
        "action": "counter_unload",
        "event": "Кассир извлекает деньги из лотка счётчика и складывает их обратно в пачку на столе."
      },
      {
        "t": 8.8,
        "action": "other",
        "event": "Кассир складывает руки на столе и смотрит в сторону, ожидая."
      },
      {
        "t": 12.0,
        "action": "inspect",
        "event": "Кассир снова берёт синий предмет со стола, перекладывает его в левую руку и продолжает рассматривать."
      },
      {
        "t": 14.8,
        "action": "other",
        "event": "Кассир кладёт синий предмет обратно на стол и остаётся сидеть, оперев руки на столешницу."
      }
    ],
