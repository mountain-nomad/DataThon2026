      },
      {
        "t": 8.0,
        "action": "other",
        "event": "Кассир откладывает деньги на стол, откидывается на спинку кресла и поворачивает голову в сторону стеклянной двери."
      },
      {
        "t": 9.0,
        "action": "other",
        "event": "Кассир встаёт из-за стола, опираясь на столешницу, и поворачивается спиной к камере."
      },
      {
        "t": 10.0,
        "action": "safe_open",
        "event": "Кассир подходит к серому металлическому сейфу и открывает его дверцу."
      },
      {
        "t": 12.0,
        "action": "other",
