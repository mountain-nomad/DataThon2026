    "events": [
      {
        "t": 0.0,
        "action": "setup",
        "event": "Кассир в розовой кофте сидит за деревянным столом в освещенном кабинете, работая на открытом ноутбуке, рядом на столе лежат сканер и телефон, за стеклянной дверью виден офисный зал."
      },
      {
        "t": 7.0,
        "action": "other",
        "event": "Кассир перестает печатать, отводит руки от клавиатуры и поворачивает голову в сторону стеклянной двери."
      },
      {
        "t": 11.0,
        "action": "other",
        "event": "Кассир отталкивается от стола и встает со стула, поворачиваясь спиной к камере."
      },
      {
        "t": 15.0,
        "action": "other",
        "event": "Кассир подходит к серому металлическому шкафу, расположенному в углу комнаты, и нажимает на кнопку на стене, после чего освещение в кабинете гаснет."
      },
      {
        "t": 17.0,
        "action": "other",
        "event": "В темноте кассир направляется к стеклянной двери, открывает ее и выходит в коридор."
      },
      {
        "t": 24.0,
        "action": "client_leave",
        "event": "Кассир полностью покидает помещение, закрывая за собой дверь, в кабинете остаются включенный ноутбук и оборудование."
      }
    ],
