# Copy to inference/.env on the GPU machine. Never commit the real key.
# Bearer token the backend sends (its ML_SERVICE_KEY). Required when listening on a public address.
INFERENCE_API_KEY=
# Largest video accepted (upload or link), in MB.
INFERENCE_MAX_VIDEO_MB=500
# Used when the request has no deadline_sec (e.g. a manual curl test).
INFERENCE_DEFAULT_DEADLINE_SEC=1800
INFERENCE_DOWNLOAD_TIMEOUT_SEC=120
# 1 keeps each run's prompts, raw answers and reports in ml/artifacts/service/ (the video itself is
# always deleted). Off by default: the run folder also holds evidence frames.
KEEP_ARTIFACTS=0
