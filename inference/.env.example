# Model endpoint (OpenAI-compatible). Export these before running, or put them in your shell.
# RunPod serverless vLLM: https://api.runpod.ai/v2/<ENDPOINT_ID>/openai/v1
INFERENCE_ENDPOINT_URL=https://api.runpod.ai/v2/oy7aum4aybkuee/runsync
# Never commit the real key.
INFERENCE_API_KEY=rpa_EA7NLJW387QHMI35TICX3ZIDYTB4OUHOFDNRZ3FJ174iei
# The exact model id the endpoint serves (GET <INFERENCE_ENDPOINT_URL>/models lists it).
INFERENCE_MODEL=qwen/qwen3.8-27b
