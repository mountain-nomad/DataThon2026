# Copy to .env (used by `make backend` and by docker compose).
API_KEY=change-me
# mock (fake results), http (the ML microservice in inference/), or module.path:ClassName
ANALYZER=http
ML_SERVICE_URL=http://localhost:8001
# The ML service's INFERENCE_API_KEY (needed when it's reached over HTTPS).
ML_SERVICE_KEY=
# true: send the Supabase signed link; false: upload the file (GPU host without internet).
ML_SEND_LINK=true
MOCK_DELAY_SEC=3
DATA_DIR=./data
LEGAL_MAPPING_FILE=./fortebank_violation_legal_mapping_updated.yaml
CROSSWALK_FILE=./specialist_crosswalk.yaml
MAX_UPLOAD_MB=500
MAX_CONCURRENT_JOBS=1
JOB_TIMEOUT_SEC=270
MIN_CONFIDENCE=0.5
UI_ENABLED=true
LOCAL_ONLY_UI=true
UPLOAD_RETENTION_HOURS=0
# supabase: every upload is also stored in a private Supabase Storage bucket (created on start);
# local: DATA_DIR/uploads only. Remote storage of jury test videos needs the organiser's OK.
STORAGE_BACKEND=supabase
SUPABASE_URL=
# service_role / secret key. Backend only: never put it in the frontend's env.
SUPABASE_KEY=
SUPABASE_BUCKET=videos
SIGNED_URL_TTL_SEC=3600